<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Centello.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Centello</ApplicationTitle>
    <ApplicationId>it.christiancapoccetti.centesimo</ApplicationId>
    <ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Leaves CS8509 on: an enum switch with no discard arm fails the build when a member has no arm. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(DevBuild)' == 'true'">
    <ApplicationTitle>Centello Dev</ApplicationTitle>
    <ApplicationId>$(ApplicationId).dev</ApplicationId>
    <DefineConstants>$(DefineConstants);CENTELLO_DEV</DefineConstants>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DevBuild)' == 'true' And '$(Configuration)' == 'Release'">
    <IntermediateOutputPath>obj/Dev/Release/</IntermediateOutputPath>
    <OutputPath>bin/Dev/Release/</OutputPath>
  </PropertyGroup>

  <!-- Both signing inputs are paths. The password file also works with the AAB signer. -->
  <PropertyGroup Condition="'$(PlayRelease)' == 'true'">
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(PLAY_UPLOAD_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>upload</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>file:$(PLAY_UPLOAD_PASSWORD_FILE)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>file:$(PLAY_UPLOAD_PASSWORD_FILE)</AndroidSigningKeyPass>
  </PropertyGroup>

  <Target Name="RequirePlayUploadKey" BeforeTargets="PrepareForBuild" Condition="'$(PlayRelease)' == 'true'">
    <Error Condition="'$(DevBuild)' == 'true'" Text="DevBuild and PlayRelease cannot be combined." />
    <Error Condition="'$(Configuration)' != 'Release'" Text="PlayRelease builds only with -c Release." />
    <Error Condition="'$(PLAY_UPLOAD_KEYSTORE)' == '' Or '$(PLAY_UPLOAD_PASSWORD_FILE)' == ''" Text="PlayRelease needs PLAY_UPLOAD_KEYSTORE and PLAY_UPLOAD_PASSWORD_FILE, both set to file paths." />
    <Error Condition="!Exists('$(PLAY_UPLOAD_PASSWORD_FILE)')" Text="The upload password file was not found." />
    <Error Condition="!Exists('$(PLAY_UPLOAD_KEYSTORE)')" Text="The upload key was not found at PLAY_UPLOAD_KEYSTORE: $(PLAY_UPLOAD_KEYSTORE)" />
  </Target>

  <ItemGroup Condition="'$(FirebaseAndroidConfigFile)' != ''">
    <AndroidAsset Include="$(FirebaseAndroidConfigFile)" LogicalName="firebase-android.json" Link="firebase-android.json" />
  </ItemGroup>

  <Target Name="GenerateFirebaseAppIdResource" BeforeTargets="_ComputeAndroidResourcePaths"
          Condition="'$(FirebaseAndroidConfigFile)' != ''">
    <PropertyGroup>
      <_FirebaseAppId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(FirebaseAndroidConfigFile)')), '&quot;applicationId&quot;\s*:\s*&quot;(1:[1-9][0-9]*:android:[a-f0-9]+)&quot;').Result('$1'))</_FirebaseAppId>
      <_FirebaseAppIdResource>$(IntermediateOutputPath)firebase/values/firebase_app_id.xml</_FirebaseAppIdResource>
    </PropertyGroup>
    <Error Condition="'$(_FirebaseAppId)' == ''" Text="The staged Firebase Android configuration is missing a valid applicationId." />
    <MakeDir Directories="$(IntermediateOutputPath)firebase/values" />
    <WriteLinesToFile File="$(_FirebaseAppIdResource)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;resources&gt;&lt;string name=&quot;google_app_id&quot; translatable=&quot;false&quot;&gt;$(_FirebaseAppId)&lt;/string&gt;&lt;/resources&gt;" />
    <ItemGroup>
      <AndroidResource Include="$(_FirebaseAppIdResource)" Link="Resources/values/firebase_app_id.xml" />
      <FileWrites Include="$(_FirebaseAppIdResource)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <CentelloInvitePublicKey Condition="'$(CentelloInvitePublicKey)' == ''">$(CENTELLO_INVITE_PUBLIC_KEY)</CentelloInvitePublicKey>
  </PropertyGroup>
  <UsingTask TaskName="CheckInviteVerificationKey" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PublicKey ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(NuGetPackageRoot)/bouncycastle.cryptography/$(BouncyCastleVersion)/lib/netstandard2.0/BouncyCastle.Cryptography.dll" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = Convert.FromBase64String(PublicKey);
        if (Convert.ToBase64String(bytes) != PublicKey || !Org.BouncyCastle.Math.EC.Rfc8032.Ed25519.ValidatePublicKeyFull(bytes, 0))
            Log.LogError("CENTELLO_INVITE_PUBLIC_KEY must contain a valid Ed25519 public key generated by the invitations utility.");
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ValidateAiInvitePublicKey" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PlayRelease)' == 'true' And '$(CentelloInvitePublicKey)' == ''" Text="Set CENTELLO_INVITE_PUBLIC_KEY to the Ed25519 public key printed by the invitations utility." />
    <Error Condition="'$(CentelloInvitePublicKey)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(CentelloInvitePublicKey)', '^[A-Za-z0-9+/]{43}=$'))" Text="CENTELLO_INVITE_PUBLIC_KEY must contain the base64 encoding of the 32-byte public key." />
    <CheckInviteVerificationKey Condition="'$(CentelloInvitePublicKey)' != ''" PublicKey="$(CentelloInvitePublicKey)" />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="CentelloInvitePublicKey" Value="$(CentelloInvitePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141516" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="..\..\docs\brand\segno-colore-su-scuro.svg" Link="Resources\Images\segno_su_scuro.svg" BaseSize="64,64" />
    <MauiImage Include="..\..\docs\brand\segno-colore-su-chiaro.svg" Link="Resources\Images\segno_su_chiaro.svg" BaseSize="64,64" />
    <MauiAsset Include="Resources\Raw\*" LogicalName="%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\LICENSE" LogicalName="PolyForm-Noncommercial-1.0.0.md" />
    <!-- The Android tab bar label style can only name a font resource, so the SemiBold cut is also packaged as one. -->
    <AndroidResource Include="Resources\Fonts\Archivo-SemiBold.ttf" LogicalName="font\archivo_semibold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centello.Application\Centello.Application.csproj" />
    <ProjectReference Include="..\Centello.FirebaseAi.Android\Centello.FirebaseAi.Android.csproj" />
    <ProjectReference Include="..\Centello.Infrastructure\Centello.Infrastructure.csproj" />
  </ItemGroup>
</Project>
