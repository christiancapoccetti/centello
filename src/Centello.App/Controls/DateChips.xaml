<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Class="Centello.App.Controls.DateChips">
    <Grid>
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="24,0" Spacing="8">
                <c:Chip x:Name="TodayChip" Text="Oggi" Tapped="OnTodayTapped" />
                <c:Chip x:Name="YesterdayChip" Text="Ieri" Tapped="OnYesterdayTapped" />
                <c:Chip x:Name="OtherChip" Glyph="{x:Static app:MaterialSymbols.CalendarToday}" Tapped="OnOtherTapped" />
            </HorizontalStackLayout>
        </ScrollView>
        <!-- Never seen or touched: the third chip opens its native dialog. -->
        <DatePicker x:Name="Picker" WidthRequest="1" HeightRequest="1" Opacity="0" InputTransparent="True" HorizontalOptions="Start" DateSelected="OnDateSelected" AutomationProperties.IsInAccessibleTree="False" />
    </Grid>
</ContentView>
