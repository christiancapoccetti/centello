<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Centello.App.Controls"
             x:Class="Centello.App.Controls.ExpenseRow">
    <!-- 58 is the least: with a larger font the title and the detail take the lines they need, and the amount goes
         under them when it would leave them too little width. -->
    <Grid MinimumHeightRequest="58" ColumnDefinitions="36,*" ColumnSpacing="14" RowDefinitions="*,1">
        <c:CategoryTile IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" Size="36" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
        <c:TrailingValueLayout Grid.Column="1" Margin="0,6">
            <VerticalStackLayout>
                <Label Text="{Binding Title}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" MaxLines="2" />
                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" MaxLines="2">
                    <Label.Triggers>
                        <!-- A row with nothing to add keeps its title in the middle. -->
                        <DataTrigger TargetType="Label" Binding="{Binding Detail}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            <Label Text="{Binding Amount}" Style="{StaticResource AmountLabel}" />
        </c:TrailingValueLayout>
        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
        <Button Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="Transparent" Text="" Clicked="OnClicked" SemanticProperties.Description="{Binding Description}" SemanticProperties.Hint="Apri la spesa" />
    </Grid>
</ContentView>
