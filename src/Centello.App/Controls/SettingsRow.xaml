<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             x:Class="Centello.App.Controls.SettingsRow"
             x:Name="Root">
    <!-- A line of a settings list: what it is, a word on it and, when it does something, the tap and, when it leads somewhere, the arrow or, when it flips something, the switch. -->
    <Grid Margin="24,0" MinimumHeightRequest="64" ColumnDefinitions="36,*,Auto" ColumnSpacing="14" RowDefinitions="*,1">
        <Label x:Name="Mark" Style="{StaticResource IconGlyph}" Text="{Binding Glyph, Source={x:Reference Root}}" VerticalOptions="Center" />
        <VerticalStackLayout Grid.Column="1" Padding="0,10" VerticalOptions="Center">
            <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" MaxLines="2" />
            <Label x:Name="DetailLabel" Text="{Binding Detail, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>
        <Switch x:Name="Switcher" Grid.Column="2" VerticalOptions="Center" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" IsVisible="False" />
        <Label x:Name="Arrow" Grid.Column="2" Style="{StaticResource IconGlyph}" TextColor="{t:Theme Mute}" Margin="0,0,-4,0" IsVisible="False" />
        <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
        <!-- The tap reaches the edges of the screen: the margin of the row is the room around its text, not a dead zone. -->
        <Button x:Name="Tap" Grid.RowSpan="2" Grid.ColumnSpan="3" Margin="-24,0" BackgroundColor="Transparent" Text="" IsVisible="False" Clicked="OnTapClicked" />
    </Grid>
</ContentView>
