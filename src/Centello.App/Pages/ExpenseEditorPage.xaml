<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:local="clr-namespace:Centello.App"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Name="RootPage"
             x:Class="Centello.App.Pages.ExpenseEditorPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="All">
    <Grid RowDefinitions="56,*">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PhoneLandscape">
                    <VisualState.StateTriggers>
                        <c:PhoneLandscapeTrigger Page="{x:Reference RootPage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="Grid.RowDefinitions" Value="48,*" />
                        <Setter TargetName="Form" Property="c:PhoneLandscapeForm.IsSplit" Value="True" />
                        <Setter TargetName="HeaderRule" Property="BoxView.IsVisible" Value="True" />
                        <Setter TargetName="FooterActions" Property="VerticalStackLayout.Padding" Value="24,4" />
                        <Setter TargetName="SaveButton" Property="Button.MinimumHeightRequest" Value="48" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Padding="4,0" ColumnDefinitions="48,*,48" ColumnSpacing="4">
            <Button Style="{StaticResource IconGlyphButton}" Text="{x:Static app:MaterialSymbols.Close}" Clicked="OnCloseClicked" SemanticProperties.Description="Chiudi" />
            <Label Grid.Column="1" Margin="4,0,0,0" Text="{Binding Title}" Style="{StaticResource TitleLarge}" VerticalOptions="Center" LineBreakMode="TailTruncation" SemanticProperties.HeadingLevel="Level1" />
            <Button Grid.Column="2" Style="{StaticResource IconGlyphButton}" Text="{x:Static app:MaterialSymbols.MoreVert}" IsVisible="{Binding IsEditMode}" Clicked="OnMenuClicked" SemanticProperties.Description="Altre azioni" />
        </Grid>

        <BoxView x:Name="HeaderRule" Style="{StaticResource Hairline}" VerticalOptions="End" InputTransparent="True" IsVisible="False" />

        <c:PhoneLandscapeForm x:Name="Form" Grid.Row="1">
            <c:PhoneLandscapeForm.Primary>
                <VerticalStackLayout>
                    <Border Margin="24,4,24,0" Padding="14,10" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{t:Theme PositiveContainer}" IsVisible="{Binding HasDraft}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Style="{StaticResource IconGlyph}" FontSize="20" Text="{Binding Draft.Source.Glyph}" TextColor="{t:Theme OnPositiveContainer}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding Draft.Banner}" Style="{StaticResource LabelLarge}" LineHeight="1.25" TextColor="{t:Theme OnPositiveContainer}" />
                        </Grid>
                    </Border>
                    <c:AmountField IsCompact="{Binding IsSplit, Source={x:Reference Form}}" x:Name="AmountInput" Margin="24,8,24,0" Text="{Binding Amount}" ErrorText="{Binding AmountError}" />
                </VerticalStackLayout>
            </c:PhoneLandscapeForm.Primary>
            <c:PhoneLandscapeForm.PrimaryTail>
                <VerticalStackLayout>
                    <c:TextField Margin="24,14,24,0" Label="Nota" Placeholder="Facoltativa" MaxLength="500" Text="{Binding Note}" />
                </VerticalStackLayout>
            </c:PhoneLandscapeForm.PrimaryTail>
            <c:PhoneLandscapeForm.Secondary>
                <VerticalStackLayout>
                    <Label Text="Categoria" Style="{StaticResource FieldLabel}" />
                    <c:CategoryGrid Margin="24,5,24,5" Items="{Binding Picker.Categories}" CategoryTapped="OnCategoryTapped" NewTapped="OnNewCategoryTapped" />
                    <c:InlineError Margin="24,0" Text="{Binding Picker.CategoryError}" />
                    <Label Text="Tag" Style="{StaticResource FieldLabel}" />
                    <c:TagChips Margin="0,-3,0,0" Items="{Binding Picker.Tags}" Hint="{Binding Picker.TagHint}" TagTapped="OnTagTapped" />
                    <c:InlineError Margin="24,0" Text="{Binding Picker.TagError}" />
                    <Label Text="Data" Style="{StaticResource FieldLabel}" />
                    <c:DateChips Margin="0,-3,0,0" Date="{Binding OccurredOn}" MaximumDate="{x:Static sys:DateTime.Today}" />
                </VerticalStackLayout>
            </c:PhoneLandscapeForm.Secondary>
            <c:PhoneLandscapeForm.Footer>
                <Grid RowDefinitions="1,Auto" local:SnackbarAnchor.IsAnchor="True">
                    <BoxView Style="{StaticResource Hairline}" />
                    <VerticalStackLayout x:Name="FooterActions" Grid.Row="1" Padding="24,12" Spacing="8">
                        <c:InlineError Text="{Binding ErrorMessage}" />
                        <Button x:Name="SaveButton" Text="Salva spesa" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>
                </Grid>
            </c:PhoneLandscapeForm.Footer>
        </c:PhoneLandscapeForm>

        <!-- The overflow menu. The layer under it takes the tap that closes it. -->
        <Grid x:Name="MenuLayer" Grid.RowSpan="2" IsVisible="False" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuDismissed" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource MenuSurface}" Margin="0,52,12,0" HorizontalOptions="End" VerticalOptions="Start">
                <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.Delete}" TextColor="{t:Theme Alert}" />
                    <Label Grid.Column="1" Text="Elimina spesa" FontSize="15" TextColor="{t:Theme Alert}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                    <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnDeleteClicked" SemanticProperties.Description="Elimina spesa" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
