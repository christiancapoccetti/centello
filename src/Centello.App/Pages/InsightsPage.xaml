<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Class="Centello.App.Pages.InsightsPage"
             x:Name="RootPage"
             Title="Insight"
             SafeAreaEdges="All">
    <Grid x:Name="PageLayout" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PhoneLandscape">
                    <VisualState.StateTriggers>
                        <c:PhoneLandscapeTrigger Page="{x:Reference RootPage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="Auto,*,0" />
                        <Setter Property="ColumnDefinitions" Value="43*,57*" />
                        <Setter TargetName="InsightsSummary" Property="Grid.Row" Value="1" />
                        <Setter TargetName="InsightsReports" Property="ScrollView.IsVisible" Value="True" />
                        <Setter TargetName="EmptyInsights" Property="Layout.Padding" Value="16,8,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Label Grid.ColumnSpan="2" MinimumHeightRequest="56" Margin="24,0" Text="Insight" Style="{StaticResource TitleLarge}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />

        <c:PeriodSwitcher x:Name="PeriodSelector" Grid.Row="1" Margin="24,0,8,0" Period="{Binding Overview.Period}" HasNext="{Binding Overview.Navigation.HasNext}" PreviousTapped="OnPreviousTapped" NextTapped="OnNextTapped" ToggleTapped="OnPeriodToggled" />

        <ScrollView x:Name="InsightsSummary" Grid.Row="2">
            <VerticalStackLayout x:Name="SummaryBody" Padding="0,0,0,24">
                <c:InlineError Margin="24,8,24,0" Text="{Binding ErrorMessage}" />

                <VerticalStackLayout x:Name="Spending" IsVisible="{Binding HasSpending}">
                    <!-- Android keeps the font ascent above a 48sp line and the descent below it. The negative
                         margins take that room back. -->
                    <Label Style="{StaticResource SummaryDisplay}" Margin="24,4,24,-8">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Total}" />
                                <Span Text="&#160;" FontSize="12" FontAutoScalingEnabled="False" />
                                <Span Text="€" FontSize="28" FontAutoScalingEnabled="False" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Style="{StaticResource BodyLarge}" Margin="24,8,24,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Overview.Summary.Lead}" />
                                <Span Text="{Binding Overview.Summary.Emphasis}" FontFamily="{x:Static t:Fonts.Bold}" TextColor="{t:Theme Ink}" />
                                <Span Text="{Binding Overview.Summary.Tail}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid IsVisible="{Binding HasRecap}" Margin="24,18,24,0" MinimumHeightRequest="64" ColumnDefinitions="36,*,Auto" ColumnSpacing="14" RowDefinitions="1,*,1">
                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
                        <!-- The tile is the ink and its glyph the ground, so it reads on the paper and on the graphite. -->
                        <Border Grid.Row="1" WidthRequest="36" HeightRequest="36" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="{t:Theme Ink}" AutomationProperties.IsInAccessibleTree="False">
                            <Border.StrokeShape>
                                <Rectangle />
                            </Border.StrokeShape>
                            <Label Style="{StaticResource IconGlyph}" FontSize="21" Text="{x:Static app:MaterialSymbols.AutoStories}" TextColor="{t:Theme Ground}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="0,8" VerticalOptions="Center">
                            <Label Text="{Binding Recap.Title}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Recap.Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <Label Grid.Row="1" Grid.Column="2" Margin="-8,0,-4,0" Style="{StaticResource IconGlyph}" FontSize="20" Text="{x:Static app:MaterialSymbols.ChevronRight}" TextColor="{t:Theme Mute}" VerticalOptions="Center" />
                        <BoxView Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
                        <Button Grid.RowSpan="3" Grid.ColumnSpan="3" BackgroundColor="Transparent" Text="" Clicked="OnRecapClicked" SemanticProperties.Description="{Binding Recap.Title}" SemanticProperties.Hint="{Binding Recap.Detail}" />
                    </Grid>

                    <VerticalStackLayout x:Name="Reports" IsVisible="{Binding HasSpending}">
                        <Label Text="{Binding Overview.Pace.Title}" Style="{StaticResource SectionTitle}" Margin="24,30,24,1" SemanticProperties.HeadingLevel="Level2" />
                        <c:PaceChartView Margin="24,16,24,0" Chart="{Binding Overview.Pace}" />

                        <VerticalStackLayout IsVisible="{Binding Overview.HasWaterfall}">
                            <Label Text="{Binding Overview.Waterfall.Title}" Style="{StaticResource SectionTitle}" Margin="24,30,24,1" SemanticProperties.HeadingLevel="Level2" />
                            <c:WaterfallChartView Margin="24,16,24,0" Chart="{Binding Overview.Waterfall}" />
                        </VerticalStackLayout>

                        <Label Text="Da tenere d'occhio" Style="{StaticResource SectionTitle}" Margin="24,22,24,1" IsVisible="{Binding HasInsights}" SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Insights}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="24,0" ColumnDefinitions="24,*" ColumnSpacing="14" RowDefinitions="Auto,1">
                                        <Label Style="{StaticResource IconGlyph}" Margin="0,15,0,0" Text="{Binding Glyph}" TextColor="{t:Theme Mute}" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Padding="0,11,0,0">
                                            <Label Text="{Binding Title}" Style="{StaticResource TitleMedium}" />
                                            <Label Text="{Binding Description}" Style="{StaticResource BodyMedium}" />
                                            <!-- The link ends the row: its padding is the room under it and its touch target. -->
                                            <c:ActionLink Text="{Binding Action}" Padding="0,8,16,14" HorizontalOptions="Start" Tapped="OnInsightTapped" />
                                        </VerticalStackLayout>
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Per categoria" Style="{StaticResource SectionTitle}" Margin="24,22,24,1" SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="24,0" MinimumHeightRequest="64" ColumnDefinitions="36,*,Auto" ColumnSpacing="14" RowDefinitions="*,1">
                                        <c:CategoryTile IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" Size="36" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        <c:TrailingValueLayout Grid.Column="1" Margin="0,8">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Name}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" MaxLines="2" />
                                                <!-- The bar is the spending against the largest category, the number is the share of the total.
                                                     What does not fit on the line goes to the next one, so the badge never crowds the amount. -->
                                                <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,2,0,0">
                                                    <c:FractionBar WidthRequest="96" HeightRequest="4" Margin="0,0,8,0" Fraction="{Binding ShareOfTop}" ColorKey="{Binding ColorKey}" />
                                                    <Label Text="{Binding Share}" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalOptions="Center" />
                                                    <Border Style="{StaticResource Badge}" VerticalOptions="Center">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Change.Tone}" Value="{x:Static app:InsightChangeTone.Lower}">
                                                                <Setter Property="BackgroundColor" Value="{t:Theme PositiveContainer}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Label Text="{Binding Change.Text}" FontFamily="{x:Static t:Fonts.Bold}" FontSize="12" VerticalTextAlignment="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Change.Tone}" Value="{x:Static app:InsightChangeTone.Lower}">
                                                                    <Setter Property="TextColor" Value="{t:Theme OnPositiveContainer}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Change.Tone}" Value="{x:Static app:InsightChangeTone.Same}">
                                                                    <Setter Property="TextColor" Value="{t:Theme Mute}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </FlexLayout>
                                            </VerticalStackLayout>
                                            <Label Text="{Binding Amount}" Style="{StaticResource AmountLabel}" />
                                        </c:TrailingValueLayout>
                                        <Label Grid.Column="2" Margin="-8,0,-4,0" Style="{StaticResource IconGlyph}" FontSize="20" Text="{x:Static app:MaterialSymbols.ChevronRight}" TextColor="{t:Theme Mute}" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
                                        <Button Grid.RowSpan="2" Grid.ColumnSpan="3" BackgroundColor="Transparent" Text="" CommandParameter="{Binding .}" Clicked="OnCategoryClicked" SemanticProperties.Description="{Binding Description}" SemanticProperties.Hint="Apri la categoria" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="I tuoi insight vengono elaborati solo su questo dispositivo." Style="{StaticResource Caption}" Margin="24,28,24,8" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="EmptyInsights" Padding="32,56,32,24" IsVisible="{Binding IsEmpty}">
                    <Label Style="{StaticResource IconGlyph}" FontSize="40" Text="{x:Static app:MaterialSymbols.BarChart}" TextColor="{t:Theme Mute}" />
                    <Label Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" HorizontalTextAlignment="Center" />
                    <Label Text="Aggiungi una spesa per vedere come cambiano le tue spese." Style="{StaticResource Lead}" Margin="0,4,0,0" MaximumWidthRequest="260" HorizontalTextAlignment="Center" />
                    <Button Text="Aggiungi spesa" Style="{StaticResource TonalButton}" Margin="0,20,0,0" HorizontalOptions="Center" Clicked="OnAddExpenseClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView x:Name="InsightsReports" Grid.Row="1" Grid.Column="1" IsVisible="False" />
    </Grid>
</ContentPage>
