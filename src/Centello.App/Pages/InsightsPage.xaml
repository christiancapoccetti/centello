<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             xmlns:vm="clr-namespace:Centello.App.ViewModels"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Class="Centello.App.Pages.InsightsPage"
             x:Name="RootPage"
             Title="Insight"
             SafeAreaEdges="All">
    <Grid x:Name="PageLayout" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PhoneLandscape">
                    <VisualState.StateTriggers>
                        <c:PhoneLandscapeTrigger Page="{x:Reference RootPage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="RowDefinitions" Value="Auto,*,0" />
                        <Setter Property="ColumnDefinitions" Value="43*,57*" />
                        <Setter TargetName="InsightsSummary" Property="Grid.Row" Value="1" />
                        <Setter TargetName="InsightsReports" Property="ScrollView.IsVisible" Value="True" />
                        <Setter TargetName="EmptyInsights" Property="Layout.Padding" Value="16,8,16,24" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Label Grid.ColumnSpan="2" MinimumHeightRequest="56" Margin="24,0" Text="Insight" Style="{StaticResource TitleLarge}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />

        <c:PeriodSwitcher x:Name="PeriodSelector" Grid.Row="1" Margin="24,0,8,0" Period="{Binding Overview.Period}" HasNext="{Binding Overview.Navigation.HasNext}" PreviousTapped="OnPreviousTapped" NextTapped="OnNextTapped" ToggleTapped="OnPeriodToggled" />

        <ScrollView x:Name="InsightsSummary" Grid.Row="2">
            <VerticalStackLayout x:Name="SummaryBody" Padding="0,0,0,24">
                <c:InlineError Margin="24,8,24,0" Text="{Binding ErrorMessage}" />

                <VerticalStackLayout x:Name="Spending" IsVisible="{Binding HasReports}">
                    <Label Style="{StaticResource Caption}" Margin="24,6,24,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Range}" />
                                <Span Text="{Binding Total}" FontFamily="{x:Static t:Fonts.Bold}" TextColor="{t:Theme Ink}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Grid IsVisible="{Binding HasRecap}" Margin="24,18,24,0" MinimumHeightRequest="64" ColumnDefinitions="36,*,Auto" ColumnSpacing="14" RowDefinitions="1,*,1">
                        <BoxView Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
                        <!-- The tile is the ink and its glyph the ground, so it reads on the paper and on the graphite. -->
                        <Border Grid.Row="1" WidthRequest="36" HeightRequest="36" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="{t:Theme Ink}" AutomationProperties.IsInAccessibleTree="False">
                            <Border.StrokeShape>
                                <Rectangle />
                            </Border.StrokeShape>
                            <Label Style="{StaticResource IconGlyph}" FontSize="21" Text="{x:Static app:MaterialSymbols.AutoStories}" TextColor="{t:Theme Ground}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Padding="0,8" VerticalOptions="Center">
                            <Label Text="{Binding Recap.Title}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Recap.Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </VerticalStackLayout>
                        <Label Grid.Row="1" Grid.Column="2" Margin="-8,0,-4,0" Style="{StaticResource IconGlyph}" FontSize="20" Text="{x:Static app:MaterialSymbols.ChevronRight}" TextColor="{t:Theme Mute}" VerticalOptions="Center" />
                        <BoxView Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Hairline}" />
                        <Button x:Name="RecapButton" Grid.RowSpan="3" Grid.ColumnSpan="3" BackgroundColor="Transparent" Text="" Clicked="OnRecapClicked" SemanticProperties.Description="{Binding Recap.Title}" SemanticProperties.Hint="{Binding Recap.Detail}" />
                    </Grid>

                    <VerticalStackLayout Padding="24,18,24,0">
                        <Label Text="Dove sono finiti i soldi?" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                        <Label Style="{StaticResource TitleLarge}" Margin="0,6,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Overview.Composition.Statement.Lead}" FontFamily="{x:Static t:Fonts.Regular}" />
                                    <Span Text="{Binding Overview.Composition.Statement.Emphasis}" />
                                    <Span Text="{Binding Overview.Composition.Statement.Tail}" FontFamily="{x:Static t:Fonts.Regular}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding Overview.Composition.Context}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <FlexLayout IsVisible="{Binding HasLeadingCategories}" Wrap="Wrap" AlignItems="Center" Margin="0,14,0,2">
                            <Label Text="{Binding CurrentShareLabel}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                            <BoxView IsVisible="{Binding HasPriorShares}" Color="{t:Theme Ink}" WidthRequest="2" HeightRequest="10" Margin="0,0,5,0" AutomationProperties.IsInAccessibleTree="False" />
                            <Label IsVisible="{Binding HasPriorShares}" Text="{Binding ComparedShareLabel}" Style="{StaticResource Caption}" />
                        </FlexLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeadingCategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:InsightCategoryRow">
                                    <Grid RowDefinitions="Auto,6" RowSpacing="5" ColumnDefinitions="24,*,Auto,Auto" ColumnSpacing="8" MinimumHeightRequest="48" Padding="0,7,0,6">
                                        <c:CategoryTile IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" Size="24" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TitleMedium}" VerticalOptions="Center" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Grid.Column="2" Text="{Binding Amount}" Style="{StaticResource Caption}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Grid.Column="3" Text="{Binding Share}" Style="{StaticResource LabelLarge}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                        <c:InsightShareBar Grid.Row="1" Grid.ColumnSpan="4" Fraction="{Binding ShareFraction}" Marker="{Binding ComparedShare}" ColorKey="{Binding ColorKey}" AutomationProperties.IsInAccessibleTree="False" />
                                        <Label Grid.RowSpan="2" Grid.ColumnSpan="4" IsVisible="{Binding IsResidual}" InputTransparent="True" SemanticProperties.Description="{Binding ShareDescription}" />
                                        <Button Grid.RowSpan="2" Grid.ColumnSpan="4" BackgroundColor="Transparent" Text="" IsVisible="{Binding CanOpen}" CommandParameter="{Binding .}" Clicked="OnCategoryClicked" SemanticProperties.Description="{Binding ShareDescription}" SemanticProperties.Hint="Apri la categoria" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid Margin="0,8,0,0" ColumnDefinitions="*,24" MinimumHeightRequest="48" RowDefinitions="1,*">
                            <BoxView Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                            <Label Grid.Row="1" Text="{Binding DisclosureTitle}" Style="{StaticResource TitleMedium}" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DisclosureGlyph}" Style="{StaticResource IconGlyph}" TextColor="{t:Theme Mute}" AutomationProperties.IsInAccessibleTree="False" />
                            <Button Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="Transparent" Text="" Clicked="OnDisclosureClicked" SemanticProperties.Description="{Binding DisclosureTitle}" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding CategoriesExpanded}">
                            <Grid ColumnDefinitions="1.4*,*,*,0.8*" ColumnSpacing="6" Padding="0,4">
                                <Label Text="Categoria" Style="{StaticResource BodySmall}" />
                                <Label Grid.Column="1" Text="{Binding ComparedPeriod}" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" />
                                <Label Grid.Column="2" Text="{Binding CurrentPeriod}" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" />
                                <Label Grid.Column="3" Text="Var." Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InsightCategoryRow">
                                        <Grid RowDefinitions="1,*" ColumnDefinitions="1.4*,*,*,0.8*" ColumnSpacing="6" MinimumHeightRequest="48">
                                            <BoxView Grid.ColumnSpan="4" Style="{StaticResource Hairline}" />
                                            <Label Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BodySmall}" VerticalOptions="Center" LineBreakMode="WordWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ComparedAmount}" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding Amount}" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Row="1" Grid.Column="3" Text="{Binding Change}" Style="{StaticResource BodySmall}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="CharacterWrap" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Row="1" Grid.ColumnSpan="4" IsVisible="{Binding IsResidual}" InputTransparent="True" SemanticProperties.Description="{Binding TableDescription}" />
                                            <Button Grid.Row="1" Grid.ColumnSpan="4" BackgroundColor="Transparent" Text="" IsVisible="{Binding CanOpen}" CommandParameter="{Binding .}" Clicked="OnCategoryClicked" SemanticProperties.Description="{Binding TableDescription}" SemanticProperties.Hint="Apri la categoria" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Reports" IsVisible="{Binding HasReports}" Padding="24,18,24,24">
                        <BoxView Style="{StaticResource Hairline}" />
                        <Label Text="{Binding ComparisonTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" SemanticProperties.HeadingLevel="Level2" />
                        <c:Segmented Items="Andamento,Per categoria" SelectedIndex="{Binding ChartIndex}" />
                        <VerticalStackLayout IsVisible="{Binding ShowTrend}" Margin="0,16,0,0">
                            <Label Text="{Binding Overview.Pace.Title}" Style="{StaticResource TitleMedium}" SemanticProperties.HeadingLevel="Level3" />
                            <Label Text="{Binding TrendContext}" Style="{StaticResource Caption}" Margin="0,4,0,8" />
                            <c:PaceChartView Margin="0,12,0,0" Chart="{Binding Overview.Pace}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout IsVisible="{Binding ShowDeltas}" Margin="0,16,0,0">
                            <Label Text="Dove hai speso di più o di meno?" Style="{StaticResource TitleMedium}" SemanticProperties.HeadingLevel="Level3" />
                            <Label Style="{StaticResource BodyMedium}" Margin="0,4,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Overview.Summary.Lead}" />
                                        <Span Text="{Binding Overview.Summary.Emphasis}" FontFamily="{x:Static t:Fonts.Bold}" TextColor="{t:Theme Ink}" />
                                        <Span Text="{Binding Overview.Summary.Tail}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding DeltaDetail}" IsVisible="{Binding HasDeltaDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <Label Text="La spesa è rimasta uguale in ogni categoria." IsVisible="{Binding HasUnchangedCategories}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <VerticalStackLayout Margin="0,8,0,0" BindableLayout.ItemsSource="{Binding Deltas}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InsightCategoryRow">
                                        <Grid ColumnDefinitions="1.2*,1.65*,*" ColumnSpacing="8" MinimumHeightRequest="28">
                                            <Label Text="{Binding Name}" Style="{StaticResource Caption}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                            <c:InsightDeltaBar Grid.Column="1" HeightRequest="8" VerticalOptions="Center" ColorKey="{Binding ColorKey}" Fraction="{Binding DeltaFraction}" Zero="{Binding DeltaZero}" AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Grid.Column="2" Text="{Binding Delta}" Style="{StaticResource LabelLarge}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="CharacterWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Label Text="I tuoi insight vengono elaborati solo su questo dispositivo." Style="{StaticResource Caption}" Margin="0,22,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="EmptyInsights" Padding="32,56,32,24" IsVisible="{Binding IsEmpty}">
                    <Label Style="{StaticResource IconGlyph}" FontSize="40" Text="{x:Static app:MaterialSymbols.BarChart}" TextColor="{t:Theme Mute}" />
                    <Label Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" HorizontalTextAlignment="Center" />
                    <Label Text="Aggiungi una spesa per vedere come cambiano le tue spese." Style="{StaticResource Lead}" Margin="0,4,0,0" MaximumWidthRequest="260" HorizontalTextAlignment="Center" />
                    <Button Text="Aggiungi spesa" Style="{StaticResource TonalButton}" Margin="0,20,0,0" HorizontalOptions="Center" Clicked="OnAddExpenseClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView x:Name="InsightsReports" Grid.Row="1" Grid.Column="1" IsVisible="False" />
    </Grid>
</ContentPage>
