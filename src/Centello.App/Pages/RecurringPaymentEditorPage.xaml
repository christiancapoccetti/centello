<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:local="clr-namespace:Centello.App"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Class="Centello.App.Pages.RecurringPaymentEditorPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="All">
    <Grid RowDefinitions="56,*,Auto">
        <Grid Padding="4,0" ColumnDefinitions="48,*" ColumnSpacing="4">
            <Button Style="{StaticResource IconGlyphButton}" Text="{x:Static app:MaterialSymbols.Close}" Clicked="OnCloseClicked" SemanticProperties.Description="Chiudi" />
            <Label Grid.Column="1" Margin="4,0,0,0" Text="{Binding Title}" Style="{StaticResource TitleLarge}" VerticalOptions="Center" LineBreakMode="TailTruncation" SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView x:Name="Form" Grid.Row="1">
            <VerticalStackLayout Padding="0,0,0,24">
                <Label Text="Una regola che crea la spesa per te" Style="{StaticResource Lead}" Margin="24,1,24,0" />
                <Border Style="{StaticResource InfoCard}" Margin="24,16,24,0" IsVisible="{Binding HasStateNote}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{Binding StateGlyph}" TextColor="{t:Theme Mute}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Text="{Binding StateNote}" LineHeight="1.45" />
                    </Grid>
                </Border>
                <c:AmountField Margin="24,8,24,0" Text="{Binding Amount}" ErrorText="{Binding AmountError}" IsReadOnly="{Binding IsReadOnly}" />
                <Label Text="Categoria" Style="{StaticResource FieldLabel}" />
                <c:CategoryGrid Margin="24,5,24,5" Items="{Binding Picker.Categories}" CanChoose="{Binding CanSave}" CategoryTapped="OnCategoryTapped" NewTapped="OnNewCategoryTapped" />
                <c:InlineError Margin="24,0" Text="{Binding Picker.CategoryError}" />
                <Label Text="Tag" Style="{StaticResource FieldLabel}" />
                <c:TagChips Margin="0,-3,0,0" Items="{Binding Picker.Tags}" Hint="{Binding Picker.TagHint}" IsEnabled="{Binding CanSave}" TagTapped="OnTagTapped" />
                <c:InlineError Margin="24,0" Text="{Binding Picker.TagError}" />
                <Label Text="Ogni" Style="{StaticResource FieldLabel}" />
                <c:Segmented Margin="24,5,24,0" Items="Settimana,Mese,Anno" SelectedIndex="{Binding FrequencyIndex}" IsEnabled="{Binding CanSave}" />
                <c:DateField Margin="24,14,24,0" Label="{Binding DateLabel}" Date="{Binding ScheduleDate}" IsReadOnly="{Binding IsReadOnly}" />
                <Label Text="Termina" Style="{StaticResource FieldLabel}" />
                <c:Segmented Margin="24,5,24,0" Items="Mai,In una data" SelectedIndex="{Binding EndIndex}" IsEnabled="{Binding CanSave}" />
                <c:DateField Margin="24,14,24,0" Label="Ultima spesa il" Date="{Binding EndDate}" ErrorText="{Binding EndDateError}" IsVisible="{Binding ShowEndDate}" />
                <c:TextField Margin="24,14,24,0" Label="Nota" Placeholder="Per esempio Netflix" MaxLength="500" Text="{Binding Note}" IsReadOnly="{Binding IsReadOnly}" />

                <Border Style="{StaticResource InfoCard}" Margin="24,16,24,0" IsVisible="{Binding IsReminderOffered}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.Notifications}" TextColor="{t:Theme Mute}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Vuoi una notifica il giorno della spesa?" FontFamily="{x:Static t:Fonts.Bold}" FontSize="15" LineHeight="1.35" />
                            <Label Text="Ti arriva sul telefono la mattina alle 9. Puoi toglierla quando vuoi." Style="{StaticResource BodyMedium}" LineHeight="1.45" Margin="0,4,0,12" />
                            <Button Text="Attiva promemoria" Style="{StaticResource OutlinedButton}" HorizontalOptions="Start" Clicked="OnReminderClicked" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- What changes the payment for good stays apart from the form, under its own rule. -->
                <VerticalStackLayout Margin="24,40,24,0" IsVisible="{Binding CanManage}">
                    <BoxView Style="{StaticResource Hairline}" Margin="0,0,0,24" />
                    <Button Text="Metti in pausa" Style="{StaticResource OutlinedButton}" IsVisible="{Binding CanPause}" Clicked="OnPauseClicked">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static app:MaterialSymbols.Pause}" FontFamily="{x:Static t:Fonts.Icons}" Size="20" Color="{t:Theme Ink}" />
                        </Button.ImageSource>
                    </Button>
                    <Label Text="Non crea spese finché non lo riprendi." Style="{StaticResource Caption}" Margin="4,6,4,16" IsVisible="{Binding CanPause}" />
                    <Button Text="Riprendi" Style="{StaticResource OutlinedButton}" IsVisible="{Binding CanResume}" Clicked="OnResumeClicked">
                        <Button.ImageSource>
                            <FontImageSource Glyph="{x:Static app:MaterialSymbols.PlayArrow}" FontFamily="{x:Static t:Fonts.Icons}" Size="20" Color="{t:Theme Ink}" />
                        </Button.ImageSource>
                    </Button>
                    <Label Text="Ricomincia dalla prossima data." Style="{StaticResource Caption}" Margin="4,6,4,16" IsVisible="{Binding CanResume}" />
                    <Button Text="Termina pagamento" Style="{StaticResource DangerOutlinedButton}" Clicked="OnEndClicked" />
                    <Label Text="Crea l'ultima spesa alla prossima data, poi si ferma." Style="{StaticResource Caption}" Margin="4,6,4,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="1,Auto" local:SnackbarAnchor.IsAnchor="True">
            <BoxView Style="{StaticResource Hairline}" IsVisible="{Binding CanSave}" />
            <VerticalStackLayout Grid.Row="1" Padding="24,12" Spacing="8" IsVisible="{Binding CanSave}">
                <c:InlineError Text="{Binding ErrorMessage}" />
                <Button Text="Salva pagamento" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
