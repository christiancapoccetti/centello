<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Name="RootPage"
             x:Class="Centello.App.Pages.SettingsPage"
             Title="Impostazioni"
             SafeAreaEdges="All">
    <Grid RowDefinitions="56,*">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PhoneLandscape">
                    <VisualState.StateTriggers>
                        <c:PhoneLandscapeTrigger Page="{x:Reference RootPage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="Grid.RowDefinitions" Value="48,*" />
                        <Setter TargetName="Form" Property="c:PhoneLandscapeForm.IsSplit" Value="True" />
                        <Setter TargetName="HeaderRule" Property="BoxView.IsVisible" Value="True" />
                        <Setter TargetName="SecondaryHeading" Property="Label.Margin" Value="24,8,24,2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Label Padding="24,0" Text="Impostazioni" Style="{StaticResource TitleLarge}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />

        <BoxView x:Name="HeaderRule" Style="{StaticResource Hairline}" VerticalOptions="End" InputTransparent="True" IsVisible="False" />

        <c:PhoneLandscapeForm x:Name="Form" Grid.Row="1">
            <c:PhoneLandscapeForm.Primary>
                <VerticalStackLayout>
                    <Label Text="Dati" Style="{StaticResource SectionTitle}" Margin="24,8,24,2" SemanticProperties.HeadingLevel="Level2" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Repeat}" Title="Pagamenti regolari" Detail="{Binding RecurringSummary}" Kind="Navigation" Tapped="OnRecurringPaymentsTapped" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Backup}" Title="Backup ed export" Detail="Google, file di backup e CSV" Kind="Navigation" Tapped="OnBackupTapped" />

                    <Label Text="Notifiche" Style="{StaticResource SectionTitle}" Margin="24,24,24,2" SemanticProperties.HeadingLevel="Level2" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Notifications}" Title="Riepilogo del mese" Detail="{Binding RecapNoticeDetail}" IsOn="{Binding RecapNoticeOn, Mode=OneWay}" Kind="Toggle" Toggled="OnRecapNoticeToggled" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Notifications}" Title="Apri impostazioni Android" Kind="Action" IsVisible="{Binding RecapNoticeBlocked}" Tapped="OnAndroidNotificationSettingsTapped" />
                </VerticalStackLayout>
            </c:PhoneLandscapeForm.Primary>
            <c:PhoneLandscapeForm.Secondary>
                <VerticalStackLayout>
                    <Label x:Name="SecondaryHeading" Text="Voce, foto e PDF" Style="{StaticResource SectionTitle}" Margin="24,24,24,2" SemanticProperties.HeadingLevel="Level2" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Mic}" Title="Inserimento spese con l’AI" Detail="Detta una spesa o scegli una foto o un PDF" IsOn="{Binding DraftsEnabled, Mode=OneWay}" Kind="Toggle" Toggled="OnDraftConsentToggled" />
                    <c:NoteRow Margin="24,12,24,0" Glyph="{x:Static app:MaterialSymbols.Cloud}" Text="Per preparare la bozza, Centello invia a Google tramite Firebase AI Logic il contenuto scelto, i nomi delle categorie e dei tag attivi e la data di oggi. Puoi sempre inserire una spesa a mano." />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.ConfirmationNumber}" Title="{Binding AiInviteTitle}" Detail="{Binding AiInviteDetail}" Kind="Navigation" Tapped="OnAiInviteTapped" />

                    <Label Text="Informazioni" Style="{StaticResource SectionTitle}" Margin="24,24,24,2" SemanticProperties.HeadingLevel="Level2" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Chat}" Title="Feedback veloce" Detail="Scrivi due righe su Google Moduli." Kind="ExternalLink" IsVisible="{Binding HasFeedbackForm}" Tapped="OnFeedbackTapped" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Info}" Title="{Binding VersionText}" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Description}" Title="Licenze" Detail="Centello e componenti open source" Kind="Navigation" Tapped="OnLicensesTapped" />
                    <c:SettingsRow Glyph="{x:Static app:MaterialSymbols.Visibility}" Title="Informativa sulla privacy" Detail="Si apre nel browser" Kind="Action" Tapped="OnPrivacyPolicyTapped" />
                </VerticalStackLayout>
            </c:PhoneLandscapeForm.Secondary>
        </c:PhoneLandscapeForm>
    </Grid>
</ContentPage>
