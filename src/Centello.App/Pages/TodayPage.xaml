<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centello.App.Theming"
             xmlns:c="clr-namespace:Centello.App.Controls"
             xmlns:local="clr-namespace:Centello.App"
             xmlns:app="clr-namespace:Centello.Application;assembly=Centello.Application"
             x:Class="Centello.App.Pages.TodayPage"
             x:Name="RootPage"
             Title="Oggi"
             SafeAreaEdges="All">
    <Grid x:Name="PageLayout" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="PhoneLandscape">
                    <VisualState.StateTriggers>
                        <c:PhoneLandscapeTrigger Page="{x:Reference RootPage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Property="ColumnDefinitions" Value="46*,54*" />
                        <Setter TargetName="TodayActivity" Property="ScrollView.IsVisible" Value="True" />
                        <Setter TargetName="TotalAmount" Property="Label.FontSize" Value="52" />
                        <Setter TargetName="TotalCurrency" Property="Span.FontSize" Value="28" />
                        <Setter TargetName="OverviewBody" Property="Layout.Padding" Value="16,0,12,16" />
                        <Setter TargetName="Activity" Property="Layout.Padding" Value="12,0,16,16" />
                        <Setter TargetName="CaptureDock" Property="Border.Margin" Value="16,8,12,8" />
                        <Setter TargetName="CaptureButtons" Property="Grid.ColumnDefinitions" Value="*,1,48,1,48" />
                        <Setter TargetName="PhotoMenu" Property="Border.Margin" Value="16,0,16,72" />
                        <Setter TargetName="PhotoMenu" Property="Border.HorizontalOptions" Value="Start" />
                        <Setter TargetName="AccessCard" Property="Border.HorizontalOptions" Value="End" />
                        <Setter TargetName="AccessCard" Property="Border.MaximumWidthRequest" Value="420" />
                        <Setter TargetName="AccessCard" Property="Border.Margin" Value="0,8,12,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="True" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <c:PeriodSwitcher x:Name="PeriodHeader" Grid.ColumnSpan="2" Margin="24,0,8,0" MinimumHeightRequest="56" VerticalOptions="Center" IsPageTitle="True" Period="{Binding Overview.Period}" HasNext="{Binding Overview.Navigation.HasNext}" PreviousTapped="OnPreviousTapped" NextTapped="OnNextTapped" ToggleTapped="OnPeriodToggled" />

        <ScrollView x:Name="TodayOverview" Grid.Row="1">
            <VerticalStackLayout x:Name="OverviewBody" Padding="24,0,24,24">
                <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{t:Theme Alert}" />
                </Border>

                <VerticalStackLayout x:Name="Overview" IsVisible="{Binding HasOverview}">
                    <!-- Android keeps the font ascent above a 68sp line and the descent below it, about 20dp each.
                         The negative margins here and on the next label take that room back. -->
                    <Label x:Name="TotalAmount" Style="{StaticResource TotalDisplay}" Margin="0,-3,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Overview.Total}" />
                                <Span Text="&#160;" FontSize="18" FontAutoScalingEnabled="False" />
                                <Span x:Name="TotalCurrency" Text="€" FontSize="38" FontAutoScalingEnabled="False" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Style="{StaticResource BodyLarge}" Margin="0,-12,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Overview.Budget.Lead}" />
                                <Span Text="{Binding Overview.Budget.Emphasis}" FontFamily="{x:Static t:Fonts.Bold}" TextColor="{t:Theme Ink}" />
                                <Span Text="{Binding Overview.Budget.Tail}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <c:CategoryLineView Margin="0,24,0,0" HeightRequest="14" Segments="{Binding Overview.Categories.Segments}" IsVisible="{Binding Overview.Categories.HasSegments}" SemanticProperties.Description="{Binding Overview.Categories.Description}" />
                    <!-- One line: the items that fit whole, in the order of the key. An item opens its category. Its
                         padding makes the touch target 41 high and the negative margins of the row give that room back.
                         The padding to the right is the gap between items. An item that is dropped is zero wide, and
                         clipping keeps its content from drawing outside it. -->
                    <c:OneLineLayout Margin="0,-6,0,-6" BindableLayout.ItemsSource="{Binding Overview.Categories.Key}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Padding="0,12,14,12" Spacing="6" IsClippedToBounds="True" SemanticProperties.Description="{Binding Description}" SemanticProperties.Hint="Apri la categoria">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryKeyTapped" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <c:PaletteSwatch ColorKey="{Binding ColorKey}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.Error}" FontSize="14" TextColor="{t:Theme Alert}" VerticalOptions="Center" IsVisible="{Binding IsOverBudget}" />
                                    <Label Text="{Binding Text}" Style="{StaticResource Caption}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="TextColor" Value="{t:Theme Alert}" />
                                                <Setter Property="FontFamily" Value="{x:Static t:Fonts.SemiBold}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </c:OneLineLayout>

                    <VerticalStackLayout Margin="0,12,0,0" IsVisible="{Binding HasSpendChart}">
                        <Label Text="Spesa mensile" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                        <c:DailySpendChartView Chart="{Binding Overview.Chart}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Activity" IsVisible="{Binding HasOverview}">
                        <c:ActionLink Text="Vedi ultime spese" HorizontalOptions="End" MinimumHeightRequest="48"
                                      IsVisible="{Binding Overview.HasCategories}" Tapped="OnAllExpensesTapped" />

                        <VerticalStackLayout IsVisible="{Binding Overview.HasBudgetRows}">
                            <Label Text="Per categoria" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout Margin="0,4,0,0" BindableLayout.ItemsSource="{Binding BudgetItems}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinimumHeightRequest="68" ColumnDefinitions="36,*" ColumnSpacing="12" RowDefinitions="*,1">
                                            <c:CategoryTile IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" Size="36"
                                                            VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                            <VerticalStackLayout Grid.Column="1" Margin="0,8" Spacing="3" VerticalOptions="Center"
                                                                 AutomationProperties.ExcludedWithChildren="True">
                                                <c:TrailingValueLayout Spacing="8" MinContentWidth="96">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TitleMedium}" LineBreakMode="TailTruncation" MaxLines="2" />
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                                        <Label Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.Error}"
                                                               TextColor="{t:Theme Alert}" FontSize="14" VerticalOptions="Center" IsVisible="{Binding IsOverBudget}" />
                                                        <Label Grid.Column="1" Text="{Binding Amount}" Style="{StaticResource LabelLarge}" HorizontalTextAlignment="End">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                                    <Setter Property="TextColor" Value="{t:Theme Alert}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                </c:TrailingValueLayout>
                                                <Label Text="{Binding BudgetDetail}" Style="{StaticResource Caption}" IsVisible="{Binding HasBudget}" />
                                                <Grid Margin="0,2,0,0" HeightRequest="4" BackgroundColor="{t:Theme Hairline}" IsVisible="{Binding HasBudget}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding ProgressWidth}" />
                                                        <ColumnDefinition Width="{Binding RemainingWidth}" />
                                                    </Grid.ColumnDefinitions>
                                                    <c:PaletteSwatch ColorKey="{Binding ColorKey}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                                            <Button Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="Transparent" Text=""
                                                    Clicked="OnCategoryBudgetClicked" SemanticProperties.Description="{Binding Description}"
                                                    SemanticProperties.Hint="Apri la categoria" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- On first run, offer the common categories alongside manual entry in the dock. -->
                        <VerticalStackLayout IsVisible="{Binding Overview.IsFirstRun}">
                            <Label Text="Categorie suggerite" Style="{StaticResource SectionTitle}" Margin="0,22,0,1" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="Le più comuni sono già scelte. Togli quelle che non ti servono: potrai cambiarle quando vuoi." Style="{StaticResource Lead}" Margin="0,4,0,0" />
                            <FlexLayout Margin="0,4,-8,0" Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding Suggestions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The gap between chips is padding: FlexLayout counts an item margin twice. -->
                                        <ContentView Padding="0,0,8,0">
                                            <c:Chip Text="{Binding Name}" IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" IsSelected="{Binding IsSelected}" HasCheck="False" Tapped="OnSuggestionTapped" />
                                        </ContentView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Button Text="Crea categorie" Style="{StaticResource FilledButton}" Margin="0,12,0,0" IsEnabled="{Binding CanCreateSuggested}" Clicked="OnCreateSuggestedClicked">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.38" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Crea a mano" Style="{StaticResource TextActionButton}" Margin="0,8,0,0" FontFamily="{x:Static t:Fonts.Bold}" FontSize="16" Clicked="OnCreateByHandClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView x:Name="TodayActivity" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" IsVisible="False" />

        <Border x:Name="CaptureDock" Grid.Row="2" Margin="24,12" Style="{StaticResource SplitPill}" local:SnackbarAnchor.IsAnchor="True">
            <Grid x:Name="CaptureButtons" ColumnDefinitions="*,1,64,1,64">
                <Grid Margin="8,0" HorizontalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="8" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True">
                    <Label Text="{x:Static app:MaterialSymbols.Add}" Style="{StaticResource IconGlyph}" TextColor="{t:Theme Accent}" />
                    <Label Grid.Column="1" Text="Aggiungi spesa" FontFamily="{x:Static t:Fonts.Bold}" FontSize="17" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                </Grid>
                <Button BackgroundColor="Transparent" Text="" Clicked="OnAddExpenseClicked" SemanticProperties.Description="Aggiungi spesa" />
                <BoxView Grid.Column="1" Color="{t:Theme Outline}" />
                <Border Grid.Column="2" IsVisible="{Binding Capture.IsListening}" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="17" HeightRequest="17" BackgroundColor="{t:Theme Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 2" />
                <Button Grid.Column="2" Style="{StaticResource IconGlyphButton}" WidthRequest="-1" HeightRequest="-1" FontSize="26" Text="{x:Static app:MaterialSymbols.Mic}" TextColor="{t:Theme Accent}" IsEnabled="{Binding IsCaptureAvailable}" Clicked="OnSpeechClicked" SemanticProperties.Description="Avvia la registrazione">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Capture.IsListening}" Value="True">
                            <Setter Property="Text" Value="" />
                            <Setter Property="SemanticProperties.Description" Value="Ferma la registrazione" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <BoxView Grid.Column="3" Color="{t:Theme Outline}" />
                <Button Grid.Column="4" Style="{StaticResource IconGlyphButton}" WidthRequest="-1" HeightRequest="-1" FontSize="26" Text="{x:Static app:MaterialSymbols.PhotoCamera}" TextColor="{t:Theme Accent}" IsEnabled="{Binding IsCaptureAvailable}" Clicked="OnCameraClicked" SemanticProperties.Description="Fotografa una spesa">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Capture.IsChoosingPhoto}" Value="True">
                            <Setter Property="BackgroundColor" Value="{t:Theme Outline}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Grid.ColumnSpan="3" IsVisible="{Binding CanSetUpCapture}" BackgroundColor="Transparent" Text="" Clicked="OnInactiveCaptureClicked" SemanticProperties.Description="Voce e foto non configurate" />
            </Grid>
        </Border>

        <Border Grid.Row="2" IsVisible="{Binding Capture.IsListening}" InputTransparent="True" AutomationProperties.ExcludedWithChildren="True" HorizontalOptions="Center" VerticalOptions="Start" TranslationY="-36" Padding="14,6" BackgroundColor="{t:Theme SurfaceRaised}" Stroke="{t:Theme Outline}" StrokeThickness="1" StrokeShape="RoundRectangle 18">
            <Label Text="In registrazione · Tocca per fermare" Style="{StaticResource LabelLarge}" HorizontalTextAlignment="Center" />
        </Border>

        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Capture.IsChoosingPhoto}" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPhotoMenuDismissed" />
            </Grid.GestureRecognizers>
            <Border x:Name="PhotoMenu" Style="{StaticResource MenuSurface}" Margin="0,0,24,84" HorizontalOptions="End" VerticalOptions="End">
                <VerticalStackLayout>
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding CanTakePhoto}">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.PhotoCamera}" />
                        <Label Grid.Column="1" Text="Scatta una foto" FontSize="16" FontFamily="{x:Static t:Fonts.SemiBold}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnTakePhotoClicked" SemanticProperties.Description="Scatta una foto" />
                    </Grid>
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.PhotoLibrary}" />
                        <Label Grid.Column="1" Text="Scegli dalla galleria" FontSize="16" FontFamily="{x:Static t:Fonts.SemiBold}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnPickPhotoClicked" SemanticProperties.Description="Scegli dalla galleria" />
                    </Grid>
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.PictureAsPdf}" />
                        <Label Grid.Column="1" Text="Scegli un PDF" FontSize="16" FontFamily="{x:Static t:Fonts.SemiBold}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnPickPdfClicked" SemanticProperties.Description="Scegli un PDF" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Capture.IsSheetVisible}" BackgroundColor="{t:Theme Scrim}">
            <Border VerticalOptions="End" BackgroundColor="{t:Theme Ground}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="24,24,24,28">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Capture.Source.SheetTitle}" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" />
                    <c:IndeterminateBar IsVisible="{Binding Capture.IsReading}" />
                    <Label Text="{Binding Capture.Source.ReadingLine}" IsVisible="{Binding Capture.HasReadingLine}" Style="{StaticResource BodyMedium}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Capture.ErrorMessage}" IsVisible="{Binding Capture.HasError}" TextColor="{t:Theme Alert}" HorizontalTextAlignment="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" FontSize="18" Text="{x:Static app:MaterialSymbols.Cloud}" TextColor="{t:Theme Mute}" />
                        <Label Text="{Binding Capture.Source.PrivacyNote}" Style="{StaticResource LabelLarge}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Chiudi" Clicked="OnCloseCaptureClicked" IsEnabled="{Binding Capture.HasError}" Style="{StaticResource TextActionButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="AccessSheet" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False">
            <BoxView Color="{t:Theme Scrim}" AutomationProperties.IsInAccessibleTree="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccessSheetDismissed" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="AccessCard" VerticalOptions="End" BackgroundColor="{t:Theme Ground}" Stroke="{t:Theme Hairline}" StrokeShape="RoundRectangle 28,28,0,0">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="24,12,24,16" Spacing="8">
                        <BoxView WidthRequest="38" HeightRequest="4" CornerRadius="2" Margin="0,0,0,12" Color="{t:Theme Outline}" HorizontalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{Binding Title}" Style="{StaticResource TitleLarge}" FontSize="26" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding Lead}" Style="{StaticResource BodyMedium}" Margin="0,0,0,8" />
                        <Button Text="Rispondi al sondaggio" Style="{StaticResource FilledButton}" IsVisible="{Binding CanOpenSurvey}" Clicked="OnSurveyClicked" />
                        <Button Text="Inserisci a mano" Style="{StaticResource FilledButton}" Clicked="OnAccessManualClicked">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding CanOpenSurvey}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource OutlinedButton}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Ho un codice invito" Style="{StaticResource TextActionButton}" IsVisible="{Binding CanRedeem}" Clicked="OnAccessInviteClicked" />
                        <Button Text="Chiudi" Style="{StaticResource TextActionButton}" IsVisible="{Binding ShowsClose}" Clicked="OnAccessSheetDismissed" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
