<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:t="clr-namespace:Centello.App.Theming">
    <Style x:Key="BaseText" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Regular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{t:Theme Ink}" />
    </Style>
    <!-- The numerals of money at display size are the largest text on a page already: they keep their size when the
         system font grows, so a total stays on one line next to the larger text around it. -->
    <Style x:Key="TotalDisplay" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.CondensedExtraBold}" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="LineHeight" Value="1" />
    </Style>
    <Style x:Key="SummaryDisplay" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.CondensedExtraBold}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="LineHeight" Value="1" />
    </Style>
    <Style x:Key="HeadlineLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Bold}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="1.2" />
    </Style>
    <!-- The recap story: the numeral of a card, its one-line verdict and the sentence that leads into it. Cards set
         their own ink over these, since a card can sit on a category's color. -->
    <Style x:Key="StoryTotal" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.CondensedExtraBold}" />
        <Setter Property="FontSize" Value="76" />
        <Setter Property="LineHeight" Value="1" />
    </Style>
    <Style x:Key="StoryAmount" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.CondensedExtraBold}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="1" />
    </Style>
    <Style x:Key="StoryHeadline" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Bold}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="1.12" />
    </Style>
    <Style x:Key="StoryLead" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="TitleLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Bold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Bold}" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="TitleMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.SemiBold}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.25" />
    </Style>
    <Style x:Key="BodyLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="Lead" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="BodyMedium" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="BodySmall" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="LabelLarge" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.SemiBold}" />
    </Style>
    <!-- A field label starts 24 under what is above it. Android puts 3 of font padding over a 14sp line, so the
         margin is 21. What follows the label takes back the 3 under it. -->
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource LabelLarge}">
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
        <Setter Property="Margin" Value="24,21,24,0" />
    </Style>
    <Style x:Key="Hint" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="TextColor" Value="{t:Theme Mute}" />
    </Style>
    <Style x:Key="AmountLabel" TargetType="Label" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Bold}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- A glyph is a picture in a box of its own size: it keeps that size when the system font grows. -->
    <Style x:Key="IconGlyph" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static t:Fonts.Icons}" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{t:Theme Ink}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>
</ResourceDictionary>
