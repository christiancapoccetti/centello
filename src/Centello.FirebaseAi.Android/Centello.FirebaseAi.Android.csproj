<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <EnableDefaultAndroidItems>false</EnableDefaultAndroidItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DevBuild)' == 'true' And '$(Configuration)' == 'Release'">
    <IntermediateOutputPath>obj/Dev/Release/</IntermediateOutputPath>
    <OutputPath>bin/Dev/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AndroidJavaSource Include="Java/*.java" Bind="true" />
    <TransformFile Include="Transforms/Metadata.xml" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.5" />
    <PackageReference Include="Xamarin.AndroidX.Annotation.Jvm" Version="1.9.1.5" GeneratePathProperty="true" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.3.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.8.1" />
    <PackageReference Include="Xamarin.Google.ErrorProne.Annotations" Version="2.41.0.1" />
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.29" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="1.10.2.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core.Jvm" Version="1.10.2.1" />
    <PackageReference Include="Xamarin.KotlinX.Serialization.Core.Jvm" Version="1.9.0.1" />
    <AndroidExternalJavaLibrary Include="$(PkgXamarin_AndroidX_Annotation_Jvm)/jar/androidx.annotation.annotation-jvm.jar" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(DevBuild)' == 'true'">
    <AndroidJavaSource Include="Dev/AppCheckProvider.java" Bind="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug' And '$(DevBuild)' != 'true'">
    <AndroidJavaSource Include="Play/AppCheckProvider.java" Bind="true" />
  </ItemGroup>
  <Import Project="FirebaseDependencies.props" />
</Project>
