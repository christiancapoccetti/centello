  <ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(DevBuild)' == 'true'">
    <AndroidMavenLibrary Include="com.google.firebase:firebase-appcheck-debug" Version="20.1.0" Repository="Google" Bind="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug' And '$(DevBuild)' != 'true'">
