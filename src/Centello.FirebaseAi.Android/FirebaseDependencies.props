  <!-- Maven POMs reference multiplatform metadata coordinates. The Android/JVM implementations are listed above. -->
  <ItemGroup>
    <AndroidIgnoredJavaDependency Include="androidx.datastore:datastore:1.1.7" />
    <AndroidIgnoredJavaDependency Include="androidx.datastore:datastore-core:1.1.7" />
