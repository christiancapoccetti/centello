<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Centesimo.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Quattrino</ApplicationTitle>
    <ApplicationId>it.christiancapoccetti.centesimo</ApplicationId>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Leaves CS8509 on: an enum switch with no discard arm fails the build when a member has no arm. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <!-- The Google Play build signs an AAB with the upload key. Path and password come from environment variables, so
       neither is ever in the repository. A plain Release build stays an APK signed with this machine's debug key, for
       installing on test phones. -->
  <PropertyGroup Condition="'$(PlayRelease)' == 'true'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(PLAY_UPLOAD_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>upload</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:PLAY_UPLOAD_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:PLAY_UPLOAD_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <Target Name="RequirePlayUploadKey" BeforeTargets="Build" Condition="'$(PlayRelease)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release'" Text="PlayRelease builds only with -c Release." />
    <Error Condition="'$(PLAY_UPLOAD_KEYSTORE)' == '' Or '$(PLAY_UPLOAD_PASSWORD)' == ''" Text="PlayRelease needs PLAY_UPLOAD_KEYSTORE (the path to the upload key) and PLAY_UPLOAD_PASSWORD." />
    <Error Condition="!Exists('$(PLAY_UPLOAD_KEYSTORE)')" Text="The upload key was not found at PLAY_UPLOAD_KEYSTORE: $(PLAY_UPLOAD_KEYSTORE)" />
  </Target>

  <ItemGroup>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141516" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="..\..\docs\brand\segno-colore-su-scuro.svg" Link="Resources\Images\segno_su_scuro.svg" BaseSize="64,64" />
    <MauiImage Include="..\..\docs\brand\segno-colore-su-chiaro.svg" Link="Resources\Images\segno_su_chiaro.svg" BaseSize="64,64" />
    <MauiAsset Include="Resources\Raw\*" LogicalName="%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\LICENSE" LogicalName="PolyForm-Noncommercial-1.0.0.md" />
    <!-- The Android tab bar label style can only name a font resource, so the SemiBold cut is also packaged as one. -->
    <AndroidResource Include="Resources\Fonts\Archivo-SemiBold.ttf" LogicalName="font\archivo_semibold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centesimo.Application\Centesimo.Application.csproj" />
    <ProjectReference Include="..\Centesimo.Infrastructure\Centesimo.Infrastructure.csproj" />
  </ItemGroup>
</Project>
