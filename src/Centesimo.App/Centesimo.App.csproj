<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Centesimo.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Centesimo</ApplicationTitle>
    <ApplicationId>it.christiancapoccetti.centesimo</ApplicationId>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Leaves CS8509 on: an enum switch with no discard arm fails the build when a member has no arm. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#141516" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*.svg" />
    <MauiAsset Include="Resources\Raw\*" LogicalName="%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\LICENSE" LogicalName="GPL-3.0.txt" />
    <!-- The Android tab bar label style can only name a font resource, so the SemiBold cut is also packaged as one. -->
    <AndroidResource Include="Resources\Fonts\Archivo-SemiBold.ttf" LogicalName="font\archivo_semibold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Centesimo.Application\Centesimo.Application.csproj" />
    <ProjectReference Include="..\Centesimo.Infrastructure\Centesimo.Infrastructure.csproj" />
  </ItemGroup>
</Project>
