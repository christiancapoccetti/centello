<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             x:Class="Centesimo.App.Controls.CategorySelector"
             x:Name="Root">
    <FlexLayout BindableLayout.ItemsSource="{Binding Items, Source={x:Reference Root}}" Direction="Row" Wrap="Wrap">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Border FlexLayout.Basis="25%" Padding="4" Stroke="Transparent" StrokeShape="RoundRectangle 14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryContainerLight}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                        <c:CategoryTile IconKey="{Binding Icon}" ColorKey="{Binding Color}" Size="38" AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="{Binding Name}" FontSize="10" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>
