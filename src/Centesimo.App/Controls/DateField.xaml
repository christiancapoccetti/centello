<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             xmlns:app="clr-namespace:Centesimo.Application;assembly=Centesimo.Application"
             x:Class="Centesimo.App.Controls.DateField"
             x:Name="Root">
    <!-- The label sits on the top edge of the box, so the first row starts 8 above the box. -->
    <Grid RowDefinitions="64,Auto">
        <Border x:Name="Box" Margin="0,8,0,0" StrokeShape="RoundRectangle 4" BackgroundColor="Transparent" SemanticProperties.Hint="Tocca per scegliere la data">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBoxTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="Value" FontSize="16" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                <Label Grid.Column="1" Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.CalendarToday}" TextColor="{t:Theme Mute}" />
                <!-- Never seen or touched: a tap on the box opens its native dialog. -->
                <DatePicker x:Name="Picker" WidthRequest="1" HeightRequest="1" Opacity="0" InputTransparent="True" HorizontalOptions="Start" DateSelected="OnDateSelected" AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
        </Border>
        <Label x:Name="Caption"
               Text="{Binding Label, Source={x:Reference Root}}"
               Margin="12,0,0,0"
               Padding="4,0"
               FontFamily="{x:Static t:Fonts.SemiBold}"
               FontSize="12"
               BackgroundColor="{t:Theme Ground}"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               AutomationProperties.IsInAccessibleTree="False" />
        <c:InlineError Grid.Row="1" Margin="16,6,0,0" Text="{Binding ErrorText, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
