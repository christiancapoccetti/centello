<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:app="clr-namespace:Centesimo.Application;assembly=Centesimo.Application"
             x:Class="Centesimo.App.Controls.ExpandableRow"
             x:Name="Root">
    <!-- A line of a list that keeps a long text folded away until the person asks for it. -->
    <Grid Margin="24,0" RowDefinitions="Auto,Auto,1">
        <Grid MinimumHeightRequest="58" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Padding="0,8" VerticalOptions="Center">
                <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource TitleMedium}" />
                <Label Text="{Binding Subtitle, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Label x:Name="Arrow" Grid.Column="1" Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.ExpandMore}" TextColor="{t:Theme Mute}" />
            <Button x:Name="Toggle" Grid.ColumnSpan="2" Margin="-24,0" BackgroundColor="Transparent" Text="" Clicked="OnToggleClicked" />
        </Grid>
        <Label x:Name="Body" Grid.Row="1" Text="{Binding Text, Source={x:Reference Root}}" Style="{StaticResource BodySmall}" FontSize="13" LineHeight="1.55" Margin="0,0,0,16" IsVisible="False" />
        <BoxView Grid.Row="2" Style="{StaticResource Hairline}" />
    </Grid>
</ContentView>
