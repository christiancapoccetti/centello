<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             x:Class="Centesimo.App.Controls.TextField"
             x:Name="Root">
    <!-- The label sits on the top edge of the box, so the first row starts 8 above the box. -->
    <Grid RowDefinitions="64,Auto">
        <Border x:Name="Box" Margin="0,8,0,0" StrokeShape="RoundRectangle 4" BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBoxTapped" />
            </Border.GestureRecognizers>
            <Grid x:Name="Row" ColumnDefinitions="*,Auto">
                <!-- The entry is as high as its line and sits in the middle: a tap anywhere else in the box reaches it too. -->
                <c:PlainEntry x:Name="Input"
                              Text="{Binding Text, Source={x:Reference Root}}"
                              Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                              MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                              IsReadOnly="{Binding IsReadOnly, Source={x:Reference Root}}"
                              Keyboard="{Binding Keyboard, Source={x:Reference Root}}"
                              FontSize="16"
                              VerticalOptions="Center"
                              Focused="OnFocusChanged"
                              Unfocused="OnFocusChanged"
                              Completed="OnCompleted"
                              SemanticProperties.Description="{Binding Label, Source={x:Reference Root}}" />
                <Label Grid.Column="1" Text="{Binding Suffix, Source={x:Reference Root}}" FontSize="16" TextColor="{t:Theme Mute}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
        </Border>
        <Label x:Name="Caption"
               Text="{Binding Label, Source={x:Reference Root}}"
               Margin="12,0,0,0"
               Padding="4,0"
               FontFamily="{x:Static t:Fonts.SemiBold}"
               FontSize="12"
               BackgroundColor="{t:Theme Ground}"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               AutomationProperties.IsInAccessibleTree="False" />
        <Label x:Name="Helper" Grid.Row="1" Margin="16,4,16,0" Text="{Binding HelperText, Source={x:Reference Root}}" Style="{StaticResource BodySmall}" />
        <c:InlineError Grid.Row="1" Margin="16,6,0,0" Text="{Binding ErrorText, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
