<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             xmlns:app="clr-namespace:Centesimo.Application;assembly=Centesimo.Application"
             x:Class="Centesimo.App.Pages.ExpensesPage"
             Title="Spese"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="All">
    <Grid RowDefinitions="56,48,Auto,*">
        <Grid Padding="4,0" ColumnDefinitions="48,*" ColumnSpacing="4">
            <Button Style="{StaticResource IconGlyphButton}" Text="{x:Static app:MaterialSymbols.ArrowBack}" Clicked="OnBackClicked" SemanticProperties.Description="Indietro" />
            <Label Grid.Column="1" Margin="4,0,0,0" Text="Spese" Style="{StaticResource TitleLarge}" VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <c:PeriodSwitcher Grid.Row="1" Margin="24,0,8,0" CanToggle="False" Period="{Binding History.Period}" HasNext="{Binding History.Navigation.HasNext}" PreviousTapped="OnPreviousTapped" NextTapped="OnNextTapped" />

        <ScrollView x:Name="ChipScroll" Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="24,0" Spacing="8" BindableLayout.ItemsSource="{Binding Chips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <c:Chip Text="{Binding Name}" ColorKey="{Binding ColorKey}" IsSelected="{Binding IsSelected}" HasCheck="False" Tapped="OnChipTapped" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <c:InlineError Grid.Row="3" Margin="24,8" VerticalOptions="Start" Text="{Binding ErrorMessage}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None" IsVisible="{Binding HasGroups}">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <!-- The header starts 20 under the row above it. Android puts 3 of font padding over a 14sp line. -->
                    <Label Margin="24,17,24,3" FontSize="14" SemanticProperties.HeadingLevel="Level2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Label}" FontFamily="{x:Static t:Fonts.Bold}" />
                                <Span Text=" · " FontFamily="{x:Static t:Fonts.SemiBold}" TextColor="{t:Theme Mute}" />
                                <Span Text="{Binding Total}" FontFamily="{x:Static t:Fonts.SemiBold}" TextColor="{t:Theme Mute}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <c:ExpenseRow Margin="24,0" Opened="OnExpenseOpened" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Padding="32,56,32,24" IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource IconGlyph}" FontSize="40" Text="{x:Static app:MaterialSymbols.SearchOff}" TextColor="{t:Theme Mute}" />
            <Label Text="{Binding History.EmptyText}" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" HorizontalTextAlignment="Center" />
            <Label Text="Prova un altro mese o togli il filtro." Style="{StaticResource Lead}" Margin="0,4,0,0" HorizontalTextAlignment="Center" IsVisible="{Binding HasFilter}" />
            <Button Text="Mostra tutte" Style="{StaticResource OutlinedButton}" Margin="0,20,0,0" HorizontalOptions="Center" IsVisible="{Binding HasFilter}" Clicked="OnShowAllClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
