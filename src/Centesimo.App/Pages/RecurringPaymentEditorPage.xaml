<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             x:Class="Centesimo.App.Pages.RecurringPaymentEditorPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="22,12,22,0" ColumnDefinitions="Auto,*,Auto" HeightRequest="60">
            <Button Text="Chiudi" Style="{StaticResource TextActionButton}" Clicked="OnCloseClicked" />
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="64" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,14,0,24">
                <VerticalStackLayout Margin="24,0" Spacing="4">
                    <Label Text="Quanto vuoi pianificare?" Style="{StaticResource BodyMedium}" HorizontalTextAlignment="Center" />
                    <Entry Text="{Binding Amount}" Placeholder="0,00 €" Keyboard="Numeric" FontFamily="{x:Static t:Fonts.SemiBold}" FontSize="44" HorizontalTextAlignment="Center" />
                    <c:InlineError Text="{Binding AmountError}" />
                </VerticalStackLayout>
                <Label Text="Categoria" Style="{StaticResource FieldLabel}" />
                <c:CategoryGrid Margin="24,8" Items="{Binding Picker.Categories}" CategoryTapped="OnCategoryTapped" NewTapped="OnNewCategoryTapped" />
                <c:InlineError Margin="24,0" Text="{Binding Picker.CategoryError}" />
                <Label Text="Tag" Style="{StaticResource FieldLabel}" />
                <c:TagChips Items="{Binding Picker.Tags}" Hint="{Binding Picker.TagHint}" TagTapped="OnTagTapped" />
                <c:InlineError Margin="24,0" Text="{Binding Picker.TagError}" />
                <VerticalStackLayout Margin="24,24,24,0" Spacing="8">
                    <Label Text="RIPETIZIONE" Style="{StaticResource LabelLarge}" />
                    <Border Style="{StaticResource FieldContainer}"><Picker ItemsSource="{Binding Frequencies}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedFrequency}" MinimumHeightRequest="48" /></Border>
                    <Label Text="PROSSIMA SCADENZA" Style="{StaticResource LabelLarge}" />
                    <Border Style="{StaticResource FieldContainer}"><DatePicker Date="{Binding NextDueOn}" MinimumHeightRequest="48" /></Border>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="FINE (FACOLTATIVA)" Style="{StaticResource LabelLarge}" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding HasEndDate}" /></Grid>
                    <Border Style="{StaticResource FieldContainer}"><DatePicker Date="{Binding EndsOn}" IsEnabled="{Binding CanSelectEndDate}" MinimumHeightRequest="48" /></Border>
                    <c:InlineError Text="{Binding EndDateError}" />
                </VerticalStackLayout>
                <c:TextField Margin="24,16,24,0" Label="Nota" Placeholder="Per esempio Netflix" MaxLength="500" Text="{Binding Note}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Padding="24,12,24,16" Spacing="8">
            <c:InlineError Text="{Binding ErrorMessage}" />
            <Button Text="Salva pagamento" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryActionButton}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
