<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Centesimo.App.Theming"
             xmlns:c="clr-namespace:Centesimo.App.Controls"
             xmlns:local="clr-namespace:Centesimo.App"
             xmlns:app="clr-namespace:Centesimo.Application;assembly=Centesimo.Application"
             x:Class="Centesimo.App.Pages.TodayPage"
             Title="Oggi"
             SafeAreaEdges="All">
    <Grid RowDefinitions="56,*,Auto">

        <c:PeriodSwitcher Margin="24,0,8,0" VerticalOptions="Center" IsPageTitle="True" Period="{Binding Overview.Period}" HasNext="{Binding Overview.Navigation.HasNext}" PreviousTapped="OnPreviousTapped" NextTapped="OnNextTapped" ToggleTapped="OnPeriodToggled" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,24">
                <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{t:Theme Alert}" />
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasOverview}">
                    <!-- Android keeps the font ascent above a 68sp line and the descent below it, about 20dp each.
                         The negative margins here and on the next label take that room back. -->
                    <Label Style="{StaticResource TotalDisplay}" Margin="0,-3,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Overview.Total}" />
                                <Span Text=" " FontSize="18" />
                                <Span Text="€" FontSize="38" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Style="{StaticResource BodyLarge}" Margin="0,-12,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Overview.Budget.Lead}" />
                                <Span Text="{Binding Overview.Budget.Emphasis}" FontFamily="{x:Static t:Fonts.Bold}" TextColor="{t:Theme Ink}" />
                                <Span Text="{Binding Overview.Budget.Tail}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border Margin="0,6,0,0" Padding="6,0,10,0" HeightRequest="26" HorizontalOptions="Start" StrokeThickness="0" BackgroundColor="{t:Theme SurfaceRaised}" IsVisible="{Binding Overview.HasComparison}" SemanticProperties.Description="{Binding Overview.Comparison.Description}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Overview.Comparison.Trend}" Value="{x:Static app:ComparisonTrend.Lower}">
                                <Setter Property="BackgroundColor" Value="{t:Theme PositiveContainer}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Style="{StaticResource IconGlyph}" FontSize="18" Text="{x:Static app:MaterialSymbols.East}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Overview.Comparison.Trend}" Value="{x:Static app:ComparisonTrend.Lower}">
                                        <Setter Property="Text" Value="{x:Static app:MaterialSymbols.SouthEast}" />
                                        <Setter Property="TextColor" Value="{t:Theme OnPositiveContainer}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Overview.Comparison.Trend}" Value="{x:Static app:ComparisonTrend.Higher}">
                                        <Setter Property="Text" Value="{x:Static app:MaterialSymbols.NorthEast}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Overview.Comparison.Text}" Style="{StaticResource LabelLarge}" VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Overview.Comparison.Trend}" Value="{x:Static app:ComparisonTrend.Lower}">
                                        <Setter Property="TextColor" Value="{t:Theme OnPositiveContainer}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <c:CategoryLineView Margin="0,24,0,0" HeightRequest="14" Segments="{Binding Overview.Categories.Segments}" IsVisible="{Binding Overview.Categories.HasSegments}" SemanticProperties.Description="{Binding Overview.Categories.Description}" />
                    <!-- One line: the items that fit whole, in the order of the key. An item opens its category. Its
                         padding makes the touch target 41 high and the negative margins of the row give that room back.
                         The padding to the right is the gap between items. An item that is dropped is zero wide, and
                         clipping keeps its content from drawing outside it. -->
                    <c:OneLineLayout Margin="0,-6,0,-6" BindableLayout.ItemsSource="{Binding Overview.Categories.Key}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Padding="0,12,14,12" Spacing="6" IsClippedToBounds="True" SemanticProperties.Description="{Binding Description}" SemanticProperties.Hint="Apri la categoria">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryKeyTapped" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <c:PaletteSwatch ColorKey="{Binding ColorKey}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.Error}" FontSize="14" TextColor="{t:Theme Alert}" VerticalOptions="Center" IsVisible="{Binding IsOverBudget}" />
                                    <Label Text="{Binding Text}" Style="{StaticResource Caption}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOverBudget}" Value="True">
                                                <Setter Property="TextColor" Value="{t:Theme Alert}" />
                                                <Setter Property="FontFamily" Value="{x:Static t:Fonts.SemiBold}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </c:OneLineLayout>

                    <VerticalStackLayout IsVisible="{Binding Overview.HasCategories}">
                        <c:DailySpendChartView Chart="{Binding Overview.Chart}" />

                        <!-- The link is as high as the whole header, so the touch target is 47 high and its words sit on
                             the line of the title. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Ultime spese" Style="{StaticResource SectionTitle}" Margin="0,22,0,1" SemanticProperties.HeadingLevel="Level2" />
                            <c:ActionLink Grid.Column="1" Text="Vedi tutte" Padding="10,24,0,3" Margin="0,0,-4,0" Tapped="OnAllExpensesTapped" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Overview.Latest}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <c:ExpenseRow Opened="OnExpenseOpened" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Ancora nessuna spesa in questo periodo." Style="{StaticResource BodyMedium}" Margin="0,8,0,0" IsVisible="{Binding Overview.HasNoLatest}" />
                    </VerticalStackLayout>

                    <!-- The first run: without a category there is nothing an expense could go to, so the home
                         offers the common ones instead of an empty chart. -->
                    <VerticalStackLayout IsVisible="{Binding Overview.IsFirstRun}">
                        <Label Text="Crea le tue categorie per iniziare" Style="{StaticResource SectionTitle}" Margin="0,22,0,1" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Le più comuni sono già scelte. Togli quelle che non ti servono: potrai cambiarle quando vuoi." Style="{StaticResource Lead}" Margin="0,4,0,0" />
                        <FlexLayout Margin="0,4,-8,0" Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding Suggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <!-- The gap between chips is padding: FlexLayout counts an item margin twice. -->
                                    <ContentView Padding="0,0,8,0">
                                        <c:Chip Text="{Binding Name}" IconKey="{Binding IconKey}" ColorKey="{Binding ColorKey}" IsSelected="{Binding IsSelected}" HasCheck="False" Tapped="OnSuggestionTapped" />
                                    </ContentView>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Button Text="Crea categorie" Style="{StaticResource FilledButton}" Margin="0,12,0,0" IsEnabled="{Binding CanCreateSuggested}" Clicked="OnCreateSuggestedClicked">
                            <Button.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                </Trigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Crea a mano" Style="{StaticResource TextActionButton}" Margin="0,8,0,0" FontFamily="{x:Static t:Fonts.Bold}" FontSize="16" Clicked="OnCreateByHandClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Margin="24,12" Style="{StaticResource SplitPill}" local:SnackbarAnchor.IsAnchor="True">
            <Border.Triggers>
                <!-- Until a category exists there is nothing to add an expense to. -->
                <DataTrigger TargetType="Border" Binding="{Binding Overview.IsFirstRun}" Value="True">
                    <Setter Property="Opacity" Value="0.38" />
                    <Setter Property="InputTransparent" Value="True" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="*,1,64,1,64">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Style="{StaticResource IconGlyph}" Text="{x:Static app:MaterialSymbols.Add}" TextColor="{t:Theme Accent}" />
                    <Label Text="Aggiungi spesa" FontFamily="{x:Static t:Fonts.Bold}" FontSize="17" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                </HorizontalStackLayout>
                <Button BackgroundColor="Transparent" Text="" Clicked="OnAddExpenseClicked" SemanticProperties.Description="Aggiungi spesa" />
                <BoxView Grid.Column="1" Color="{t:Theme Outline}" />
                <Button Grid.Column="2" Style="{StaticResource IconGlyphButton}" WidthRequest="-1" HeightRequest="-1" FontSize="26" Text="{x:Static app:MaterialSymbols.Mic}" TextColor="{t:Theme Accent}" IsEnabled="{Binding IsCaptureAvailable}" Pressed="OnSpeechPressed" Released="OnSpeechReleased" SemanticProperties.Description="Tieni premuto per dettare" />
                <BoxView Grid.Column="3" Color="{t:Theme Outline}" />
                <Button Grid.Column="4" Style="{StaticResource IconGlyphButton}" WidthRequest="-1" HeightRequest="-1" FontSize="26" Text="{x:Static app:MaterialSymbols.PhotoCamera}" TextColor="{t:Theme Accent}" IsEnabled="{Binding IsCaptureAvailable}" Clicked="OnCameraClicked" SemanticProperties.Description="Leggi uno scontrino">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Capture.IsChoosingPhoto}" Value="True">
                            <Setter Property="BackgroundColor" Value="{t:Theme Outline}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Grid.ColumnSpan="3" IsVisible="{Binding IsCaptureUnavailable}" BackgroundColor="Transparent" Text="" Clicked="OnInactiveCaptureClicked" SemanticProperties.Description="Voce e foto non configurate" />
            </Grid>
        </Border>

        <Border Grid.Row="2" IsVisible="{Binding Capture.IsListening}" InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Start" TranslationY="-36" Padding="14,6" BackgroundColor="{t:Theme SurfaceRaised}" Stroke="{t:Theme Outline}" StrokeThickness="1" StrokeShape="RoundRectangle 18">
            <HorizontalStackLayout Spacing="8">
                <Label Style="{StaticResource IconGlyph}" FontSize="18" Text="{x:Static app:MaterialSymbols.Mic}" TextColor="{t:Theme Accent}" />
                <Label Text="Registra… rilascia per inviare" Style="{StaticResource LabelLarge}" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.RowSpan="3" IsVisible="{Binding Capture.IsChoosingPhoto}" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPhotoMenuDismissed" />
            </Grid.GestureRecognizers>
            <Border Style="{StaticResource MenuSurface}" Margin="0,0,24,84" HorizontalOptions="End" VerticalOptions="End">
                <VerticalStackLayout>
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding CanTakePhoto}">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.PhotoCamera}" />
                        <Label Grid.Column="1" Text="Scatta una foto" FontSize="16" FontFamily="{x:Static t:Fonts.SemiBold}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnTakePhotoClicked" SemanticProperties.Description="Scatta una foto" />
                    </Grid>
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label Style="{StaticResource IconGlyph}" FontSize="22" Text="{x:Static app:MaterialSymbols.PhotoLibrary}" />
                        <Label Grid.Column="1" Text="Scegli dalla galleria" FontSize="16" FontFamily="{x:Static t:Fonts.SemiBold}" VerticalTextAlignment="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Button Grid.ColumnSpan="2" Margin="-16,0" BackgroundColor="Transparent" Text="" Clicked="OnPickPhotoClicked" SemanticProperties.Description="Scegli dalla galleria" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" IsVisible="{Binding Capture.IsSheetVisible}" BackgroundColor="{t:Theme Scrim}">
            <Border VerticalOptions="End" BackgroundColor="{t:Theme Ground}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="24,24,24,28">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Capture.Source.SheetTitle}" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" />
                    <c:IndeterminateBar IsVisible="{Binding Capture.IsReading}" />
                    <Label Text="{Binding Capture.Source.ReadingLine}" IsVisible="{Binding Capture.HasReadingLine}" Style="{StaticResource BodyMedium}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Capture.Heard, StringFormat='Ho sentito: “{0}”'}" IsVisible="{Binding Capture.HasHeard}" Style="{StaticResource BodyMedium}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Capture.ErrorMessage}" IsVisible="{Binding Capture.HasError}" TextColor="{t:Theme Alert}" HorizontalTextAlignment="Center" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" FontSize="18" Text="{x:Static app:MaterialSymbols.Cloud}" TextColor="{t:Theme Mute}" />
                        <Label Text="{Binding Capture.Source.PrivacyNote}" Style="{StaticResource LabelLarge}" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Chiudi" Clicked="OnCloseCaptureClicked" IsEnabled="{Binding Capture.HasError}" Style="{StaticResource TextActionButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
