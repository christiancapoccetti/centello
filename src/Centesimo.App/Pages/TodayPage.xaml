<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:Centesimo.App.Controls" x:Class="Centesimo.App.Pages.TodayPage" Title="Oggi" SafeAreaEdges="All">
 <Grid Padding="22,14,22,16" RowDefinitions="*,56" RowSpacing="12">
  <ScrollView><VerticalStackLayout Spacing="24" Padding="0,8,0,14">
    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Ciao!" Style="{StaticResource HeadlineLarge}" /><Label Text="{Binding HomeSubtitle}" Style="{StaticResource BodyMedium}" /></VerticalStackLayout><Border Grid.Column="1" Style="{StaticResource CategoryIconContainer}" BackgroundColor="{StaticResource PrimaryContainerLight}" VerticalOptions="Center"><Label Text="€" Style="{StaticResource TitleLarge}" TextColor="{StaticResource PrimaryLight}" HorizontalOptions="Center" VerticalOptions="Center" /></Border></Grid>
    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorLight}" /></Border>
    <VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="40,*,40"><Button Text="‹" Style="{StaticResource IconButton}" IsEnabled="{Binding CanGoPrevious}" Clicked="OnPreviousMonthClicked" /><Button Grid.Column="1" WidthRequest="184" HorizontalOptions="Center" Text="{Binding MonthTitle}" BackgroundColor="{StaticResource PrimaryContainerLight}" TextColor="{StaticResource OnPrimaryContainerLight}" FontFamily="OpenSansSemibold" FontSize="16" Padding="20,0" MinimumHeightRequest="48" CornerRadius="24" Command="{Binding ToggleOverviewCommand}" SemanticProperties.Description="Cambia visualizzazione tra mese e anno" /><Button Grid.Column="2" Text="›" Style="{StaticResource IconButton}" IsEnabled="{Binding CanGoNext}" Clicked="OnNextMonthClicked" /></Grid><Border Style="{StaticResource TonalCard}" Padding="22"><VerticalStackLayout Spacing="8"><Label Text="{Binding SummaryLabel}" Style="{StaticResource LabelLarge}" TextColor="{StaticResource OnPrimaryContainerLight}" /><Label Text="{Binding MonthlyTotal}" Style="{StaticResource DisplaySmall}" TextColor="{StaticResource OnPrimaryContainerLight}" /><Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"><Label Text="{Binding BudgetSummary}" Style="{StaticResource BodyMedium}" /><Label Grid.Column="1" Text="Budget" Style="{StaticResource LabelLarge}" /></Grid><ProgressBar Progress="{Binding BudgetProgress}" HeightRequest="6" ProgressColor="{StaticResource PrimaryLight}" /></VerticalStackLayout></Border></VerticalStackLayout>
    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasCategories}"><Label Text="Per categoria" Style="{StaticResource TitleLarge}" /><controls:CategoryBreakdownList ItemsSource="{Binding Categories}" CategoryClicked="OnCategoryClicked" /></VerticalStackLayout>
   </VerticalStackLayout></ScrollView>
<Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"><Button Text="Aggiungi spesa" Clicked="OnAddExpenseClicked" Style="{StaticResource PrimaryActionButton}" HeightRequest="56" Padding="16,0" /><Grid Grid.Column="1"><HorizontalStackLayout Spacing="10"><Button Text="Scrivi" IsEnabled="{Binding IsSpeechAvailable}" Clicked="OnTypeExpenseClicked" BackgroundColor="{StaticResource PrimaryContainerLight}" TextColor="{StaticResource PrimaryLight}" FontFamily="OpenSansSemibold" HeightRequest="56" CornerRadius="28" Padding="16,0" SemanticProperties.Description="Scrivi la spesa" /><Button IsEnabled="{Binding IsSpeechAvailable}" Pressed="OnSpeechPressed" Released="OnSpeechReleased" Style="{StaticResource VoiceActionButton}" SemanticProperties.Description="Comando vocale"><Button.ImageSource><FileImageSource File="microphone.svg" /></Button.ImageSource></Button></HorizontalStackLayout><Button IsVisible="{Binding IsSpeechUnavailable}" BackgroundColor="Transparent" Text="" Clicked="OnInactiveSpeechClicked" /></Grid></Grid>
<Border Grid.Row="1" IsVisible="{Binding IsSpeechListening}" InputTransparent="True" TranslationY="-42" BackgroundColor="#E8F3F0" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,6"><HorizontalStackLayout HorizontalOptions="Center" Spacing="8"><Label Text="●" TextColor="{StaticResource ErrorLight}"/><Label Text="Registra… rilascia per inviare" Style="{StaticResource LabelLarge}"/><Label Text="▮▯▮▯▮" TextColor="{StaticResource PrimaryLight}"/></HorizontalStackLayout></Border>
  <Grid Grid.RowSpan="2" IsVisible="{Binding IsSpeechSheetVisible}" BackgroundColor="#80000000"><Border VerticalOptions="End" BackgroundColor="{StaticResource SurfaceLight}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="22,24,22,28"><VerticalStackLayout Spacing="16"><Label Text="Inserimento rapido" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" /><ActivityIndicator IsVisible="{Binding IsSpeechProcessing}" IsRunning="{Binding IsSpeechProcessing}" /><Border Style="{StaticResource FieldContainer}"><Editor Text="{Binding SpeechTranscription, Mode=TwoWay}" Placeholder="Descrivi la spesa a parole tue" AutoSize="TextChanges" MinimumHeightRequest="76" MaxLength="500" IsEnabled="{Binding IsSpeechIdle}" SemanticProperties.Description="Testo della spesa" /></Border><Label Text="{Binding SpeechErrorMessage}" IsVisible="{Binding HasSpeechError}" TextColor="{StaticResource ErrorLight}" HorizontalTextAlignment="Center" /><Label Text="☁  Audio e testo inviati a OpenAI" Style="{StaticResource LabelLarge}" HorizontalTextAlignment="Center" /><Button Text="Usa questo testo" Clicked="OnUseSpeechTextClicked" IsEnabled="{Binding CanUseSpeechText}" Style="{StaticResource PrimaryActionButton}" /><Button Text="Chiudi" Clicked="OnCloseSpeechClicked" IsEnabled="{Binding IsSpeechIdle}" Style="{StaticResource TextActionButton}" /></VerticalStackLayout></Border></Grid>

 </Grid>
</ContentPage>
