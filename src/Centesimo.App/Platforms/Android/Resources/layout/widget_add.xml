<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/add_pill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:layout_margin="8dp"
        android:background="@drawable/widget_pill"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/add_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/widget_add_description"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/add_glyph"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:tint="@color/theme_accent" />
            <ImageView
                android:id="@+id/add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:importantForAccessibility="no"
                android:tint="@color/theme_ink" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/theme_outline" />
        <FrameLayout
            android:id="@+id/mic_action"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_dictate_description">
            <ImageView
                android:id="@+id/mic_glyph"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:tint="@color/theme_accent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
