<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/add_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/widget_surface"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:id="@+id/add_action"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:contentDescription="@string/widget_add_description"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/add_glyph"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:tint="@color/theme_accent" />
            <ImageView
                android:id="@+id/add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:importantForAccessibility="no"
                android:tint="@color/theme_ink" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/mic_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill"
                android:contentDescription="@string/widget_dictate_description"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/mic_glyph"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/theme_accent" />
                <ImageView
                    android:id="@+id/mic_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/theme_ink" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/photo_action"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:background="@drawable/widget_pill"
                android:contentDescription="@string/widget_photo_description"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/photo_glyph"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/theme_accent" />
                <ImageView
                    android:id="@+id/photo_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:importantForAccessibility="no"
                    android:tint="@color/theme_ink" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
